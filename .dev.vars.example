# Copy to .dev.vars to enable Google sign-in.
# Create a Web application OAuth client in Google Cloud Console and register:
#   http://localhost:5174/api/auth/google/callback
#   <APP_ORIGIN>/api/auth/google/callback

# 32+ random characters. Required on any hosted origin.
# SESSION_SECRET=change-me-to-a-long-random-string

# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# Origin serving the app; the Google redirect is built from it.
# APP_ORIGIN=http://localhost:5174
