# Copy to .dev.vars to enable Google sign-in.
# Enable the Google provider in Supabase (Authentication -> Providers) and add
# these redirect URLs (Authentication -> URL Configuration):
#   http://localhost:5174
#   <your deployed origin>

# Public project values; never the service-role key.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon public key>
